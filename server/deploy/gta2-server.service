# systemd unit for the game server. Installed by deploy/setup-vm.sh.
# Ports: UDP 443 (WebTransport), TCP 443 (WebSocket fallback + API, TLS),
# TCP 80 (ACME challenges for renewals, redirect to https).
[Unit]
Description=gta2-world game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gta2
Group=gta2
EnvironmentFile=-/etc/default/gta2-server
ExecStart=/usr/local/bin/gta2-server serve \
  --data /var/lib/gta2/data \
  --cert /var/lib/gta2/certs/fullchain.pem \
  --key /var/lib/gta2/certs/privkey.pem \
  --port 443 --http-port 443 --tls-http --no-cert-hash \
  --redirect-port 80 --acme-webroot /var/lib/gta2/acme \
  --replay-dir /var/lib/gta2/replays \
  $GTA2_SERVER_ARGS
# SIGHUP re-reads the certificate (the certbot deploy hook sends it).
ExecReload=/bin/kill -HUP $MAINPID
# SIGTERM tells clients the server is going away, then exits within 2 s.
KillSignal=SIGTERM
TimeoutStopSec=10
Restart=on-failure
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/gta2/replays
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
