{
  "name": "@gta2-world/shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser shell: input, gamepad, asset import, UI. No framework.",
  "scripts": {
    "build": "esbuild src/main.ts src/assets/worker.ts host-worker=src/host/worker.ts --bundle --format=esm --target=es2022 --sourcemap --outdir=dist --entry-names=[name]",
    "dev": "npm run build -- --watch --servedir=.",
    "check": "tsc -p .",
    "test": "node --test test/*.test.ts",
    "test:e2e": "node test/e2e/rtc.e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "0.24.2",
    "typescript": "5.8.3"
  }
}
